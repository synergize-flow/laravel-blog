{
    "name": "synergizeflow/laravel-onboarding-blog",
    "description": "Headless blog addon package for SynergizeFlow Laravel integration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "synergizeflow/laravel-onboarding": "*",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SynergizeFlow\\Blog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SynergizeFlow\\Blog\\BlogServiceProvider"
            ]
        }
    }
}
